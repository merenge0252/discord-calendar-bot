# Discord bot トークン（Developer Portal > Bot > Reset Token）
DISCORD_BOT_TOKEN=

# 予定を書き込むカレンダーのID。
# Googleカレンダー > 対象カレンダーの設定 > 「カレンダーの統合」の "カレンダー ID"。
# 個人用の主カレンダーは通常あなたのGmailアドレスがそのままID。
CALENDAR_ID=

# サービスアカウントのJSON鍵ファイルへのパス（既定: service_account.json）
SERVICE_ACCOUNT_FILE=service_account.json

# スラッシュコマンドを即時反映させたいサーバー（ギルド）のID。
# 設定するとそのサーバーだけ起動直後に /予定 が使える（開発・単一サーバー運用向け）。
# 空にするとグローバル登録になり、全サーバーで使えるが反映に最大1時間かかる。
GUILD_ID=

# 反応させるチャンネルIDをカンマ区切りで限定（空なら全チャンネル）
ALLOWED_CHANNEL_IDS=
